# Public Supabase client (browser + server). Never put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — CMS catalog publish + commerce DML. Never use NEXT_PUBLIC_ for these.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_SECRET=

# Dedicated FFmpeg worker (server-only; never NEXT_PUBLIC_).
# App (Vercel): WORKER_URL + WORKER_SHARED_SECRET
# Worker (Render): SUPABASE_URL (or NEXT_PUBLIC_SUPABASE_URL), SUPABASE_SERVICE_ROLE_KEY,
#   WORKER_SHARED_SECRET, PORT (or WORKER_PORT), optional WORKER_MAX_CONCURRENT_JOBS,
#   WORKER_WATERMARK_FONT, WORKER_FFMPEG_TIMEOUT_MS
# WORKER_URL=http://127.0.0.1:8787
# WORKER_SHARED_SECRET=

# Razorpay — use TEST keys only until staging fulfillment is verified.
# Server: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET
# Browser: NEXT_PUBLIC_RAZORPAY_KEY_ID (must match the same test key id)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
