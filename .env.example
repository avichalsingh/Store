# Public Supabase client (browser + server). Never put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Customer Auth (Staging local): add these Redirect URLs in the Staging project
# Authentication → URL configuration (dashboard; not set from this repo):
#   http://localhost:3000/auth/callback
#   http://127.0.0.1:3000/auth/callback
# Email confirmations / magic links also need Staging SMTP (or mailer autoconfirm).
# For local password testing without SMTP, use:
#   node scripts/staging-create-test-customer.mjs --env-file .env.staging --execute


# Server-only — CMS catalog publish + commerce DML. Never use NEXT_PUBLIC_ for these.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_SECRET=

# Gate remote catalog upserts (collections + characters publish).
# Default off / unset = dry-run only (no Supabase client / no writes).
# Set to "true" only after explicit approval for the target Supabase project.
# CATALOG_REMOTE_PUBLISH=

# Dedicated FFmpeg worker (server-only; never NEXT_PUBLIC_).
# App (Vercel): WORKER_URL + WORKER_SHARED_SECRET
# Worker (Render): SUPABASE_URL (or NEXT_PUBLIC_SUPABASE_URL), SUPABASE_SERVICE_ROLE_KEY,
#   WORKER_SHARED_SECRET, PORT (or WORKER_PORT), optional WORKER_MAX_CONCURRENT_JOBS,
#   WORKER_WATERMARK_FONT, WORKER_FFMPEG_TIMEOUT_MS
# WORKER_URL=http://127.0.0.1:8787
# WORKER_SHARED_SECRET=

# Razorpay — use TEST keys only until staging fulfillment is verified.
# Server: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET
# Browser: NEXT_PUBLIC_RAZORPAY_KEY_ID (must match the same test key id)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Catalogue transfer scripts (scripts/catalog-*.mjs) — never commit real values.
# Production export reads .env.local by default; staging import reads .env.staging.
# Optional guard: CATALOG_PRODUCTION_PROJECT_REF=<prod-ref>
# CATALOG_PRODUCTION_PROJECT_REF=
