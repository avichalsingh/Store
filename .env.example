# Public Supabase client (browser + server). Never put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — CMS catalog publish. Never use NEXT_PUBLIC_ for these.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_SECRET=

